{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteResult",
  "description": "The `route` result.",
  "type": "object",
  "properties": {
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "breakdown": {
      "$ref": "#/$defs/Breakdown"
    },
    "waypoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Snapped"
      }
    },
    "legs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Leg"
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Segment"
      }
    },
    "arcs": {
      "description": "The route as arcs (`edge << 1 | reverse`; the first and last are partial).",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      }
    },
    "arc_vertex": {
      "description": "Per arc, the index of its first vertex in the geometry.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      }
    },
    "geometry": {
      "anyOf": [
        {
          "$ref": "#/$defs/RouteGeometry"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "description": "What to know (ignored reserved fields, waypoints on excluded ways).",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "summary",
    "breakdown",
    "waypoints",
    "legs",
    "segments",
    "arcs",
    "arc_vertex",
    "notes"
  ],
  "$defs": {
    "Summary": {
      "description": "The totals.",
      "type": "object",
      "properties": {
        "distance_m": {
          "type": "number",
          "format": "float"
        },
        "ascent_m": {
          "description": "Climbing beyond the noise deadband (see `docs/profile.md`).",
          "type": "number",
          "format": "float"
        },
        "descent_m": {
          "type": "number",
          "format": "float"
        },
        "duration_s": {
          "description": "A rough riding time from a speed model by surface and grade.",
          "type": "number",
          "format": "float"
        },
        "cost": {
          "description": "The profile's cost of the route (metres-equivalent): the compiled cost of every arc ridden.",
          "type": "number",
          "format": "float"
        },
        "reused_m": {
          "description": "Metres ridden twice: on ways an earlier leg rode (either direction).",
          "type": "number",
          "format": "float"
        },
        "shape_cost": {
          "description": "The route-shape costs on top of `cost` (`avoid_reuse`): the search minimised\n`cost + shape_cost` per leg.",
          "type": "number",
          "format": "float"
        },
        "unpaved_share": {
          "description": "Shares of the length, 0..1.",
          "type": "number",
          "format": "float"
        },
        "unknown_surface_share": {
          "type": "number",
          "format": "float"
        },
        "main_road_m": {
          "type": "number",
          "format": "float"
        },
        "new_share": {
          "description": "Never-ridden share (only with a personal layer).",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      },
      "required": [
        "distance_m",
        "ascent_m",
        "descent_m",
        "duration_s",
        "cost",
        "reused_m",
        "shape_cost",
        "unpaved_share",
        "unknown_surface_share",
        "main_road_m"
      ]
    },
    "Breakdown": {
      "description": "The breakdowns, longest first.",
      "type": "object",
      "properties": {
        "surface": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part"
          }
        },
        "way": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part2"
          }
        },
        "ridden": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiddenParts"
            },
            {
              "type": "null"
            }
          ]
        },
        "touched": {
          "description": "Per preference the request's profile names (an explicit 0 too), the length of the route\nwhere it applies at all (membership ≠ 0): what each slider \"touches\". Catalogue order; 0 m\nwhere it touches nothing.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part3"
          },
          "default": []
        }
      },
      "required": [
        "surface",
        "way"
      ]
    },
    "Part": {
      "description": "A length per key.",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/SurfaceKind"
        },
        "length_m": {
          "type": "number",
          "format": "float"
        },
        "share": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "key",
        "length_m",
        "share"
      ]
    },
    "SurfaceKind": {
      "description": "The surface classes of the result (the tag or a safe guess; `unknown` where neither).",
      "type": "string",
      "enum": [
        "paved",
        "paved_rough",
        "compacted",
        "gravel",
        "soft",
        "other",
        "unknown"
      ]
    },
    "Part2": {
      "description": "A length per key.",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/WayKind"
        },
        "length_m": {
          "type": "number",
          "format": "float"
        },
        "share": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "key",
        "length_m",
        "share"
      ]
    },
    "WayKind": {
      "description": "The way types of the route breakdown.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "residential",
            "service",
            "track",
            "path",
            "steps",
            "ferry",
            "other"
          ]
        },
        {
          "description": "Trunk, primary, secondary.",
          "type": "string",
          "const": "main_road"
        },
        {
          "description": "Tertiary, unclassified.",
          "type": "string",
          "const": "country_road"
        },
        {
          "description": "A separate cycle path away from motor roads.",
          "type": "string",
          "const": "bike_path"
        },
        {
          "description": "A separate cycle path beside a motor road.",
          "type": "string",
          "const": "bike_path_roadside"
        }
      ]
    },
    "RiddenParts": {
      "description": "Ridden vs. new.",
      "type": "object",
      "properties": {
        "new_m": {
          "type": "number",
          "format": "float"
        },
        "ridden_m": {
          "type": "number",
          "format": "float"
        },
        "new_share": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "new_m",
        "ridden_m",
        "new_share"
      ]
    },
    "Part3": {
      "description": "A length per key.",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/PrefId"
        },
        "length_m": {
          "type": "number",
          "format": "float"
        },
        "share": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "key",
        "length_m",
        "share"
      ]
    },
    "PrefId": {
      "description": "A soft preference of the catalogue (`catalogue().preferences`).",
      "type": "string",
      "enum": [
        "unpaved",
        "paved_smooth",
        "paved_rough",
        "fine_gravel",
        "soft_ground",
        "unknown_surface",
        "tracktype",
        "smoothness",
        "track",
        "path",
        "cycleway_sep",
        "cycleway_road",
        "residential",
        "service",
        "minor",
        "main",
        "quiet",
        "speed",
        "lanes",
        "near_road",
        "forest",
        "forest_edge",
        "water",
        "open",
        "built",
        "climb",
        "steep",
        "ramps_over_6",
        "ramps_over_8",
        "ramps_over_10",
        "ramps_over_12",
        "ramps_over_15",
        "bike_routes",
        "mtb_routes",
        "access",
        "sketchy",
        "mtb",
        "visibility",
        "novel",
        "stale",
        "familiar"
      ]
    },
    "Snapped": {
      "description": "A waypoint as snapped.",
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "point": {
          "description": "The point on the way.",
          "$ref": "#/$defs/Coord"
        },
        "distance_m": {
          "description": "Metres from the requested point.",
          "type": "number",
          "format": "float"
        },
        "edge": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fraction": {
          "description": "Position along the edge's geometry, 0..1.",
          "type": "number",
          "format": "float"
        },
        "excluded_by": {
          "description": "Set when no allowed way was within the radius and the route starts or ends on an excluded\none (it only uses that one edge to get away): what excludes it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "point",
        "distance_m",
        "edge",
        "fraction"
      ]
    },
    "Coord": {
      "description": "A coordinate in degrees.",
      "type": "object",
      "properties": {
        "lon": {
          "type": "number",
          "format": "double"
        },
        "lat": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "lon",
        "lat"
      ]
    },
    "Leg": {
      "description": "One leg (waypoint `i` → `i + 1`).",
      "type": "object",
      "properties": {
        "distance_m": {
          "type": "number",
          "format": "float"
        },
        "ascent_m": {
          "type": "number",
          "format": "float"
        },
        "descent_m": {
          "type": "number",
          "format": "float"
        },
        "duration_s": {
          "type": "number",
          "format": "float"
        },
        "cost": {
          "description": "The leg's cost under its profile (metres-equivalent).",
          "type": "number",
          "format": "float"
        },
        "reused_m": {
          "description": "Metres of it on ways earlier legs rode.",
          "type": "number",
          "format": "float"
        },
        "shape_cost": {
          "description": "The route-shape costs the search added on top of `cost` (riding again, a U-turn at the via\nit starts from), metres-equivalent.",
          "type": "number",
          "format": "float"
        },
        "arcs": {
          "description": "`[first, end)` into `arcs` and `segments`.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "settled": {
          "description": "Nodes the search settled.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "distance_m",
        "ascent_m",
        "descent_m",
        "duration_s",
        "cost",
        "reused_m",
        "shape_cost",
        "arcs",
        "segments",
        "settled"
      ]
    },
    "Segment": {
      "description": "A stretch of the route with one surface, way type and ridden state.",
      "type": "object",
      "properties": {
        "start_m": {
          "description": "Metres from the route's start.",
          "type": "number",
          "format": "float"
        },
        "length_m": {
          "type": "number",
          "format": "float"
        },
        "arcs": {
          "description": "`[first, end)` indices into the route's `arcs`.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "vertices": {
          "description": "`[first, last]` indices into the geometry's vertices (empty geometry: 0, 0).",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "surface": {
          "$ref": "#/$defs/SurfaceKind"
        },
        "way": {
          "$ref": "#/$defs/WayKind"
        },
        "ridden": {
          "description": "Ridden before (only with a personal layer).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "factor": {
          "description": "The mean cost factor per metre (the clamp included).",
          "type": "number",
          "format": "float"
        },
        "extra_m": {
          "description": "Additive cost (climbing, barriers, steps, …) in metres.",
          "type": "number",
          "format": "float"
        },
        "why": {
          "description": "Why this way: the strongest preferences here (length-weighted geometric means), at most 3,\nstrongest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reason"
          }
        }
      },
      "required": [
        "start_m",
        "length_m",
        "arcs",
        "vertices",
        "surface",
        "way",
        "factor",
        "extra_m",
        "why"
      ]
    },
    "Reason": {
      "description": "One preference's part in a cost: its factor (< 1 made it cheaper, > 1 dearer).",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/PrefId"
        },
        "factor": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "id",
        "factor"
      ]
    },
    "RouteGeometry": {
      "description": "The line: coordinates, and per vertex the distance from the start and the elevation.",
      "type": "object",
      "properties": {
        "coordinates": {
          "description": "`[lon, lat]`, 1e-6 degrees.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "distance_m": {
          "description": "Metres from the start.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          }
        },
        "elevation_m": {
          "description": "Metres (from the end nodes of each edge, linear in between); absent where the build has no\nelevations.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "required": [
        "coordinates",
        "distance_m"
      ]
    }
  }
}
