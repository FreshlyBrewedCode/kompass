{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteRequest",
  "description": "The `route` request.",
  "type": "object",
  "properties": {
    "waypoints": {
      "description": "Two or more: start, vias, end.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Waypoint"
      }
    },
    "profile": {
      "$ref": "#/$defs/Profile"
    },
    "leg_profiles": {
      "description": "Per leg (waypoint i → i + 1), a profile replacing `profile`; `null` keeps it.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/Profile"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "options": {
      "$ref": "#/$defs/RouteOptions",
      "default": {
        "snap_radius_m": 250.0,
        "geometry": true,
        "avoid_reuse": true
      }
    },
    "overrides": {
      "description": "This plan's exceptions to the profile, by edge, for every leg (`docs/routing.md`, \"This plan's\nexceptions\"): avoid, prefer or allow an edge. Each edge at most once.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/EdgeOverride"
      }
    },
    "via_zones": {
      "description": "Reserved: \"somewhere through here\" zones.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Zone"
      }
    },
    "avoid_zones": {
      "description": "Reserved: zones to stay out of.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Zone"
      }
    },
    "sketch": {
      "description": "Reserved: a sketched line.",
      "anyOf": [
        {
          "$ref": "#/$defs/Sketch"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "waypoints",
    "profile"
  ],
  "$defs": {
    "Waypoint": {
      "description": "A waypoint of the request.",
      "type": "object",
      "properties": {
        "lon": {
          "type": "number",
          "format": "double"
        },
        "lat": {
          "type": "number",
          "format": "double"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "lon",
        "lat"
      ]
    },
    "Profile": {
      "description": "A routing profile.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Display name (presets have one).",
          "type": [
            "string",
            "null"
          ]
        },
        "base": {
          "description": "The preset this profile was made from (the UI's diff against it; routing ignores it).",
          "type": [
            "string",
            "null"
          ]
        },
        "weights": {
          "description": "Soft preferences. An absent id has no opinion (factor 1); an explicit 0 is the same for\nrouting, but stays on screen.",
          "type": "object",
          "properties": {
            "access": {
              "$ref": "#/$defs/Weight"
            },
            "bike_routes": {
              "$ref": "#/$defs/Weight"
            },
            "built": {
              "$ref": "#/$defs/Weight"
            },
            "climb": {
              "$ref": "#/$defs/Weight"
            },
            "cycleway_road": {
              "$ref": "#/$defs/Weight"
            },
            "cycleway_sep": {
              "$ref": "#/$defs/Weight"
            },
            "familiar": {
              "$ref": "#/$defs/Weight"
            },
            "fine_gravel": {
              "$ref": "#/$defs/Weight"
            },
            "forest": {
              "$ref": "#/$defs/Weight"
            },
            "forest_edge": {
              "$ref": "#/$defs/Weight"
            },
            "lanes": {
              "$ref": "#/$defs/Weight"
            },
            "main": {
              "$ref": "#/$defs/Weight"
            },
            "minor": {
              "$ref": "#/$defs/Weight"
            },
            "mtb": {
              "$ref": "#/$defs/Weight"
            },
            "mtb_routes": {
              "$ref": "#/$defs/Weight"
            },
            "near_road": {
              "$ref": "#/$defs/Weight"
            },
            "novel": {
              "$ref": "#/$defs/Weight"
            },
            "open": {
              "$ref": "#/$defs/Weight"
            },
            "path": {
              "$ref": "#/$defs/Weight"
            },
            "paved_rough": {
              "$ref": "#/$defs/Weight"
            },
            "paved_smooth": {
              "$ref": "#/$defs/Weight"
            },
            "quiet": {
              "$ref": "#/$defs/Weight"
            },
            "ramps_over_10": {
              "$ref": "#/$defs/Weight"
            },
            "ramps_over_12": {
              "$ref": "#/$defs/Weight"
            },
            "ramps_over_15": {
              "$ref": "#/$defs/Weight"
            },
            "ramps_over_6": {
              "$ref": "#/$defs/Weight"
            },
            "ramps_over_8": {
              "$ref": "#/$defs/Weight"
            },
            "residential": {
              "$ref": "#/$defs/Weight"
            },
            "service": {
              "$ref": "#/$defs/Weight"
            },
            "sketchy": {
              "$ref": "#/$defs/Weight"
            },
            "smoothness": {
              "$ref": "#/$defs/Weight"
            },
            "soft_ground": {
              "$ref": "#/$defs/Weight"
            },
            "speed": {
              "$ref": "#/$defs/Weight"
            },
            "stale": {
              "$ref": "#/$defs/Weight"
            },
            "steep": {
              "$ref": "#/$defs/Weight"
            },
            "track": {
              "$ref": "#/$defs/Weight"
            },
            "tracktype": {
              "$ref": "#/$defs/Weight"
            },
            "unknown_surface": {
              "$ref": "#/$defs/Weight"
            },
            "unpaved": {
              "$ref": "#/$defs/Weight"
            },
            "visibility": {
              "$ref": "#/$defs/Weight"
            },
            "water": {
              "$ref": "#/$defs/Weight"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "limits": {
          "description": "Hard limits.",
          "type": "object",
          "properties": {
            "legal_only": {
              "$ref": "#/$defs/LimitValue"
            },
            "max_grade": {
              "$ref": "#/$defs/LimitValue"
            },
            "max_mtb_scale": {
              "$ref": "#/$defs/LimitValue"
            },
            "no_ferries": {
              "$ref": "#/$defs/LimitValue"
            },
            "no_main_roads": {
              "$ref": "#/$defs/LimitValue"
            },
            "no_stairs": {
              "$ref": "#/$defs/LimitValue"
            },
            "no_unknown_surface": {
              "$ref": "#/$defs/LimitValue"
            },
            "paved_only": {
              "$ref": "#/$defs/LimitValue"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "bounds": {
          "description": "The factor clamp; defaults apply when absent. In the structured model only `max_factor`\ncounts (`min_factor` must stay at its default: `detours` takes its place).",
          "anyOf": [
            {
              "$ref": "#/$defs/Bounds"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_m": {
          "description": "What a right-angle turn at a junction costs, metres-equivalent (0..=500; absent:\n[`TURN_M`]; 0: turns are free). Straight on costs nothing, a U-turn twice this; leaving the\nthrough road at least half of it (`docs/routing.md#turns`).",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "boards": {
          "description": "Structured model: the tier boards.",
          "anyOf": [
            {
              "$ref": "#/$defs/Boards"
            },
            {
              "type": "null"
            }
          ]
        },
        "hills": {
          "description": "Structured model: the hills curve.",
          "anyOf": [
            {
              "$ref": "#/$defs/Hills"
            },
            {
              "type": "null"
            }
          ]
        },
        "detours": {
          "description": "Structured model: the spread of the relative factors, an exponent 0.5..=2 (default 1; more\nis \"Detours: more\", a loved way is worth a longer ride).",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      },
      "additionalProperties": false
    },
    "Weight": {
      "description": "A soft preference's strength: -100 avoid, 0 neutral, +100 seek.",
      "type": "integer",
      "minimum": -100,
      "maximum": 100
    },
    "LimitValue": {
      "description": "A limit's setting: a switch (`true` on, `false` off, as if absent), or a number for limits that\ntake one (`true` there means the catalogue's default number).",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number",
          "format": "double"
        }
      ]
    },
    "Bounds": {
      "description": "The clamp of the factor product (`docs/profile.md`): every arc costs between `min_factor` and\n`max_factor` times its length (plus additive terms). `min_factor` is the A* bound.",
      "type": "object",
      "properties": {
        "min_factor": {
          "description": "0.3..=1.0, default 0.5. Lower lets bonuses stack further (and searches slow down a little).",
          "type": "number",
          "format": "float",
          "default": 0.5
        },
        "max_factor": {
          "description": "2..=100, default 20. The most an allowed way can cost per metre.",
          "type": "number",
          "format": "float",
          "default": 20.0
        }
      },
      "additionalProperties": false
    },
    "Boards": {
      "description": "The tier boards (structured model): each board present replaces its slider preferences.",
      "type": "object",
      "properties": {
        "surface": {
          "anyOf": [
            {
              "$ref": "#/$defs/SurfaceBoard"
            },
            {
              "type": "null"
            }
          ]
        },
        "way": {
          "anyOf": [
            {
              "$ref": "#/$defs/WayBoard"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "SurfaceBoard": {
      "description": "The surface board: a tier per surface class of the way (the tag, else a safe guess; weak\nguesses and unusual surfaces are `unknown`).",
      "type": "object",
      "properties": {
        "paved": {
          "$ref": "#/$defs/Tier"
        },
        "rough_paved": {
          "$ref": "#/$defs/Tier"
        },
        "compacted": {
          "$ref": "#/$defs/Tier"
        },
        "gravel": {
          "$ref": "#/$defs/Tier"
        },
        "soft": {
          "$ref": "#/$defs/Tier"
        },
        "unknown": {
          "$ref": "#/$defs/Tier"
        }
      },
      "additionalProperties": false,
      "required": [
        "paved",
        "rough_paved",
        "compacted",
        "gravel",
        "soft",
        "unknown"
      ]
    },
    "Tier": {
      "description": "A tier of a board: how much the rider likes the ways of a row, best first in [`Tier::BEST_FIRST`].",
      "type": "string",
      "enum": [
        "avoid",
        "dislike",
        "fine",
        "like",
        "love"
      ]
    },
    "WayBoard": {
      "description": "The way board: a tier per kind of way (the route's way types; steps count as paths).",
      "type": "object",
      "properties": {
        "main": {
          "$ref": "#/$defs/Tier"
        },
        "country_road": {
          "$ref": "#/$defs/Tier"
        },
        "residential": {
          "$ref": "#/$defs/Tier"
        },
        "service": {
          "$ref": "#/$defs/Tier"
        },
        "track": {
          "$ref": "#/$defs/Tier"
        },
        "path": {
          "$ref": "#/$defs/Tier"
        },
        "cycle_path": {
          "$ref": "#/$defs/Tier"
        },
        "cycle_path_roadside": {
          "$ref": "#/$defs/Tier"
        }
      },
      "additionalProperties": false,
      "required": [
        "main",
        "country_road",
        "residential",
        "service",
        "track",
        "path",
        "cycle_path",
        "cycle_path_roadside"
      ]
    },
    "Hills": {
      "description": "The hills curve (structured model): what a metre costs against its grade, an additive term in\nmetres (`length × (curve − 1)`). Replaces `climb`, `steep` and `ramps_over_*`.",
      "type": "object",
      "properties": {
        "up": {
          "$ref": "#/$defs/UpHandles"
        },
        "down": {
          "description": "Absent: a descent counts like a climb of half its grade (at least 1).",
          "anyOf": [
            {
              "$ref": "#/$defs/DownHandles"
            },
            {
              "type": "null"
            }
          ]
        },
        "loose_pct": {
          "description": "On loose ground (gravel, soft, unusual surfaces) grades count this many percent steeper,\n0..=50 (default 0).",
          "type": "number",
          "format": "float",
          "default": 0.0
        }
      },
      "additionalProperties": false,
      "required": [
        "up"
      ]
    },
    "UpHandles": {
      "description": "The hills curve's climbing handles: the cost of a metre at that grade (percent, uphill) relative\nto a flat metre (0 % is pinned at 1). Below 1 seeks climbs (counts through the gate).",
      "type": "object",
      "properties": {
        "3": {
          "type": "number",
          "format": "float"
        },
        "6": {
          "type": "number",
          "format": "float"
        },
        "10": {
          "type": "number",
          "format": "float"
        },
        "15": {
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "3",
        "6",
        "10",
        "15"
      ]
    },
    "DownHandles": {
      "description": "The hills curve's descending handles (percent downhill), 1 or more.",
      "type": "object",
      "properties": {
        "8": {
          "type": "number",
          "format": "float"
        },
        "15": {
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "8",
        "15"
      ]
    },
    "RouteOptions": {
      "description": "Options of a route request.",
      "type": "object",
      "properties": {
        "snap_radius_m": {
          "description": "How far from a waypoint its way may be, metres (1..=5000, default 250).",
          "type": "number",
          "format": "double",
          "default": 250.0
        },
        "geometry": {
          "description": "Whether to return the geometry (coordinates, elevation, distances per vertex).",
          "type": "boolean",
          "default": true
        },
        "avoid_reuse": {
          "description": "Don't ride the same way twice (default on): legs are routed in order, and riding an edge an\nearlier leg rode (either direction) or leaving a via back the way it was reached costs\nextra. Finite costs: an out-and-back the waypoints ask for still routes.",
          "type": "boolean",
          "default": true
        },
        "reuse_cost": {
          "description": "The costs of `avoid_reuse` (for tools tuning them; absent: the defaults).",
          "anyOf": [
            {
              "$ref": "#/$defs/ReuseCost"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ReuseCost": {
      "description": "The route-shape costs of `avoid_reuse`, metres-equivalent (added to the profile's cost, which\nstays compiled and cached).",
      "type": "object",
      "properties": {
        "per_m": {
          "description": "Extra metres per metre ridden again (0..=10, default 1: [`REUSE_PER_M`]).",
          "type": "number",
          "format": "float"
        },
        "u_turn_m": {
          "description": "Extra metres for leaving a via back along the way it was reached (0..=10 000, default\n600: [`U_TURN_M`]).",
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "per_m",
        "u_turn_m"
      ]
    },
    "EdgeOverride": {
      "description": "One edge's exception in a plan.",
      "type": "object",
      "properties": {
        "edge": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/OverrideKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "edge",
        "kind"
      ]
    },
    "OverrideKind": {
      "description": "What an override does to its edge.",
      "oneOf": [
        {
          "description": "Not ridden unless there is no other way ([`AVOID_M`] per full arc on top).",
          "type": "string",
          "const": "avoid"
        },
        {
          "description": "Counts at the profile's `min_factor` (plus its additive terms); the limits do not close it.",
          "type": "string",
          "const": "prefer"
        },
        {
          "description": "The limits do not close it (a bicycle ban and one-way still do); costed as if they were off.",
          "type": "string",
          "const": "allow"
        }
      ]
    },
    "Zone": {
      "description": "An area of a via or avoid zone (reserved: accepted, not used yet).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "circle"
            },
            "center": {
              "$ref": "#/$defs/Coord"
            },
            "radius_m": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "type",
            "center",
            "radius_m"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "polygon"
            },
            "ring": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Coord"
              }
            }
          },
          "required": [
            "type",
            "ring"
          ]
        }
      ]
    },
    "Coord": {
      "description": "A coordinate in degrees.",
      "type": "object",
      "properties": {
        "lon": {
          "type": "number",
          "format": "double"
        },
        "lat": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "lon",
        "lat"
      ]
    },
    "Sketch": {
      "description": "A sketched line to fit the route to (reserved: accepted, not used yet).",
      "type": "object",
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Coord"
          }
        }
      },
      "required": [
        "points"
      ]
    }
  }
}
