{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalogue",
  "description": "The whole catalogue (`kompass profile catalogue`).",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GroupInfo"
      }
    },
    "preferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Preference"
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Limit"
      }
    },
    "bounds": {
      "$ref": "#/$defs/BoundsInfo"
    },
    "turn_m": {
      "description": "The range of `turn_m`, what a right-angle turn at a junction costs (metres-equivalent).",
      "$ref": "#/$defs/BoundRange"
    },
    "structured": {
      "description": "The structured controls (boards, tiers, the hills curve, detours; a prototype). Always\npresent.",
      "anyOf": [
        {
          "$ref": "#/$defs/StructuredInfo"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "groups",
    "preferences",
    "limits",
    "bounds",
    "turn_m"
  ],
  "$defs": {
    "GroupInfo": {
      "description": "A group's text.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Group"
        },
        "label": {
          "type": "string"
        },
        "blurb": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "blurb"
      ]
    },
    "Group": {
      "description": "A group of the picker.",
      "type": "string",
      "enum": [
        "surface",
        "ways",
        "traffic",
        "landscape",
        "terrain",
        "signs",
        "trail",
        "history"
      ]
    },
    "Preference": {
      "description": "A soft preference.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/PrefId"
        },
        "kind": {
          "description": "Always [`Kind::Soft`].",
          "$ref": "#/$defs/Kind"
        },
        "group": {
          "$ref": "#/$defs/Group"
        },
        "label": {
          "type": "string"
        },
        "short": {
          "description": "For chips.",
          "type": "string"
        },
        "hint": {
          "description": "One line: what it matches.",
          "type": "string"
        },
        "low_label": {
          "description": "Words for the slider's ends, when \"avoid\" / \"seek\" don't fit.",
          "type": [
            "string",
            "null"
          ]
        },
        "high_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "default": {
          "description": "The weight it starts with when added.",
          "type": "integer",
          "format": "int8",
          "minimum": -128,
          "maximum": 127
        },
        "max_bonus": {
          "description": "The factor on a fully matching way at +100 (< 1: cheaper).",
          "type": "number",
          "format": "float"
        },
        "max_penalty": {
          "description": "The factor on a fully matching way at −100 (> 1: dearer).",
          "type": "number",
          "format": "float"
        },
        "gated": {
          "description": "Its bonus only counts on ways the rest of the profile finds acceptable (see `docs/profile.md`).",
          "type": "boolean"
        },
        "personal": {
          "description": "Reads the personal layer (no effect without one).",
          "type": "boolean"
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coverage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "group",
        "label",
        "short",
        "hint",
        "default",
        "max_bonus",
        "max_penalty",
        "gated",
        "personal"
      ]
    },
    "PrefId": {
      "description": "A soft preference of the catalogue (`catalogue().preferences`).",
      "type": "string",
      "enum": [
        "unpaved",
        "paved_smooth",
        "paved_rough",
        "fine_gravel",
        "soft_ground",
        "unknown_surface",
        "tracktype",
        "smoothness",
        "track",
        "path",
        "cycleway_sep",
        "cycleway_road",
        "residential",
        "service",
        "minor",
        "main",
        "quiet",
        "speed",
        "lanes",
        "near_road",
        "forest",
        "forest_edge",
        "water",
        "open",
        "built",
        "climb",
        "steep",
        "ramps_over_6",
        "ramps_over_8",
        "ramps_over_10",
        "ramps_over_12",
        "ramps_over_15",
        "bike_routes",
        "mtb_routes",
        "access",
        "sketchy",
        "mtb",
        "visibility",
        "novel",
        "stale",
        "familiar"
      ]
    },
    "Kind": {
      "description": "What kind of control an entry is.",
      "oneOf": [
        {
          "description": "A slider, −100 (avoid) … +100 (seek).",
          "type": "string",
          "const": "soft"
        },
        {
          "description": "A switch that excludes ways.",
          "type": "string",
          "const": "limit_flag"
        },
        {
          "description": "A number that excludes ways beyond it.",
          "type": "string",
          "const": "limit_number"
        }
      ]
    },
    "Coverage": {
      "description": "Where a preference's data comes from, and how much of the region has it.",
      "type": "object",
      "properties": {
        "attribute": {
          "description": "The attribute the preference rests on (an `edges.parquet` column, or `personal`).",
          "type": "string"
        },
        "share": {
          "description": "Share of the region's length where it is mapped, 0..1 (only from a loaded region).",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "note": {
          "description": "What to know about the data.",
          "type": "string"
        }
      },
      "required": [
        "attribute",
        "note"
      ]
    },
    "Limit": {
      "description": "A hard limit.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/LimitId"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "group": {
          "$ref": "#/$defs/Group"
        },
        "label": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumberRange"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "group",
        "label",
        "hint"
      ]
    },
    "LimitId": {
      "description": "A hard limit of the catalogue (`catalogue().limits`).",
      "type": "string",
      "enum": [
        "no_main_roads",
        "paved_only",
        "no_unknown_surface",
        "max_grade",
        "max_mtb_scale",
        "no_stairs",
        "legal_only",
        "no_ferries"
      ]
    },
    "NumberRange": {
      "description": "The number of a number limit.",
      "type": "object",
      "properties": {
        "min": {
          "type": "number",
          "format": "double"
        },
        "max": {
          "type": "number",
          "format": "double"
        },
        "step": {
          "type": "number",
          "format": "double"
        },
        "default": {
          "description": "When the limit is switched on.",
          "type": "number",
          "format": "double"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "min",
        "max",
        "step",
        "default",
        "unit"
      ]
    },
    "BoundsInfo": {
      "description": "The ranges of [`Bounds`].",
      "type": "object",
      "properties": {
        "min_factor": {
          "$ref": "#/$defs/BoundRange"
        },
        "max_factor": {
          "$ref": "#/$defs/BoundRange"
        }
      },
      "required": [
        "min_factor",
        "max_factor"
      ]
    },
    "BoundRange": {
      "description": "A bound's range.",
      "type": "object",
      "properties": {
        "min": {
          "type": "number",
          "format": "float"
        },
        "max": {
          "type": "number",
          "format": "float"
        },
        "default": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "min",
        "max",
        "default"
      ]
    },
    "StructuredInfo": {
      "description": "The structured controls (`catalogue().structured`): boards, tiers, the hills curve, detours.",
      "type": "object",
      "properties": {
        "boards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BoardInfo"
          }
        },
        "tiers": {
          "description": "Best first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TierInfo"
          }
        },
        "hills": {
          "$ref": "#/$defs/HillsInfo"
        },
        "detours": {
          "$ref": "#/$defs/BoundRange"
        },
        "detours_hint": {
          "type": "string"
        }
      },
      "required": [
        "boards",
        "tiers",
        "hills",
        "detours",
        "detours_hint"
      ]
    },
    "BoardInfo": {
      "description": "A board, for the UI.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/BoardId"
        },
        "label": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RowInfo"
          }
        },
        "replaces": {
          "description": "The slider preferences and limits it replaces (rejected in a profile that has it).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PrefId"
          }
        },
        "replaces_limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LimitId"
          }
        }
      },
      "required": [
        "id",
        "label",
        "hint",
        "rows",
        "replaces",
        "replaces_limits"
      ]
    },
    "BoardId": {
      "description": "A board of the structured model.",
      "type": "string",
      "enum": [
        "surface",
        "way"
      ]
    },
    "RowInfo": {
      "description": "A row of a board, for the UI.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/BoardRow"
        },
        "label": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "ways": {
          "description": "Which ways fall in it.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "hint",
        "ways"
      ]
    },
    "BoardRow": {
      "description": "A row of a board: every way is in exactly one row of each board ([`BoardRow::board`]).",
      "type": "string",
      "enum": [
        "paved",
        "rough_paved",
        "compacted",
        "gravel",
        "soft",
        "unknown",
        "main",
        "country_road",
        "residential",
        "service",
        "track",
        "path",
        "cycle_path",
        "cycle_path_roadside"
      ]
    },
    "TierInfo": {
      "description": "A tier, for the UI.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Tier"
        },
        "label": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "factor": {
          "description": "A metre's factor relative to `love`; absent for `avoid` (closed: a limit).",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      },
      "required": [
        "id",
        "label",
        "hint"
      ]
    },
    "Tier": {
      "description": "A tier of a board: how much the rider likes the ways of a row, best first in [`Tier::BEST_FIRST`].",
      "type": "string",
      "enum": [
        "avoid",
        "dislike",
        "fine",
        "like",
        "love"
      ]
    },
    "HillsInfo": {
      "description": "The hills curve, for the UI.",
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "handles": {
          "description": "The handles in grade order: `down` (−15, −8), then `up` (3, 6, 10, 15); 0 % is pinned at 1.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/HandleInfo"
          }
        },
        "flat_beyond_pct": {
          "description": "The curve is flat beyond ±this many percent.",
          "type": "number",
          "format": "float"
        },
        "loose_pct": {
          "$ref": "#/$defs/BoundRange"
        },
        "loose_label": {
          "type": "string"
        },
        "curves": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CurvePreset"
          }
        },
        "replaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PrefId"
          }
        }
      },
      "required": [
        "label",
        "hint",
        "handles",
        "flat_beyond_pct",
        "loose_pct",
        "loose_label",
        "curves",
        "replaces"
      ]
    },
    "HandleInfo": {
      "description": "A handle of the hills curve: its grade and the range of its value.",
      "type": "object",
      "properties": {
        "grade_pct": {
          "description": "Percent, signed (< 0 downhill).",
          "type": "number",
          "format": "float"
        },
        "min": {
          "type": "number",
          "format": "float"
        },
        "max": {
          "type": "number",
          "format": "float"
        },
        "step": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "grade_pct",
        "min",
        "max",
        "step"
      ]
    },
    "CurvePreset": {
      "description": "A named curve.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "blurb": {
          "type": "string"
        },
        "hills": {
          "$ref": "#/$defs/Hills"
        }
      },
      "required": [
        "id",
        "label",
        "blurb",
        "hills"
      ]
    },
    "Hills": {
      "description": "The hills curve (structured model): what a metre costs against its grade, an additive term in\nmetres (`length × (curve − 1)`). Replaces `climb`, `steep` and `ramps_over_*`.",
      "type": "object",
      "properties": {
        "up": {
          "$ref": "#/$defs/UpHandles"
        },
        "down": {
          "description": "Absent: a descent counts like a climb of half its grade (at least 1).",
          "anyOf": [
            {
              "$ref": "#/$defs/DownHandles"
            },
            {
              "type": "null"
            }
          ]
        },
        "loose_pct": {
          "description": "On loose ground (gravel, soft, unusual surfaces) grades count this many percent steeper,\n0..=50 (default 0).",
          "type": "number",
          "format": "float",
          "default": 0.0
        }
      },
      "additionalProperties": false,
      "required": [
        "up"
      ]
    },
    "UpHandles": {
      "description": "The hills curve's climbing handles: the cost of a metre at that grade (percent, uphill) relative\nto a flat metre (0 % is pinned at 1). Below 1 seeks climbs (counts through the gate).",
      "type": "object",
      "properties": {
        "3": {
          "type": "number",
          "format": "float"
        },
        "6": {
          "type": "number",
          "format": "float"
        },
        "10": {
          "type": "number",
          "format": "float"
        },
        "15": {
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "3",
        "6",
        "10",
        "15"
      ]
    },
    "DownHandles": {
      "description": "The hills curve's descending handles (percent downhill), 1 or more.",
      "type": "object",
      "properties": {
        "8": {
          "type": "number",
          "format": "float"
        },
        "15": {
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "8",
        "15"
      ]
    }
  }
}
