{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompareRequest",
  "description": "`compare`: two routes' arcs (`RouteResult::arcs`) under one profile.",
  "type": "object",
  "properties": {
    "profile": {
      "$ref": "#/$defs/Profile"
    },
    "a": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      }
    },
    "b": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      }
    },
    "overrides": {
      "description": "The plan's edge overrides: the sides are costed as the router counts them.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/EdgeOverride"
      }
    }
  },
  "required": [
    "profile",
    "a",
    "b"
  ],
  "$defs": {
    "Profile": {
      "description": "A routing profile.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Display name (presets have one).",
          "type": [
            "string",
            "null"
          ]
        },
        "base": {
          "description": "The preset this profile was made from (the UI's diff against it; routing ignores it).",
          "type": [
            "string",
            "null"
          ]
        },
        "weights": {
          "description": "Soft preferences. An absent id has no opinion (factor 1); an explicit 0 is the same for\nrouting, but stays on screen.",
          "type": "object",
          "properties": {
            "access": {
              "$ref": "#/$defs/Weight"
            },
            "bike_routes": {
              "$ref": "#/$defs/Weight"
            },
            "built": {
              "$ref": "#/$defs/Weight"
            },
            "climb": {
              "$ref": "#/$defs/Weight"
            },
            "cycleway_road": {
              "$ref": "#/$defs/Weight"
            },
            "cycleway_sep": {
              "$ref": "#/$defs/Weight"
            },
            "familiar": {
              "$ref": "#/$defs/Weight"
            },
            "fine_gravel": {
              "$ref": "#/$defs/Weight"
            },
            "forest": {
              "$ref": "#/$defs/Weight"
            },
            "forest_edge": {
              "$ref": "#/$defs/Weight"
            },
            "lanes": {
              "$ref": "#/$defs/Weight"
            },
            "main": {
              "$ref": "#/$defs/Weight"
            },
            "minor": {
              "$ref": "#/$defs/Weight"
            },
            "mtb": {
              "$ref": "#/$defs/Weight"
            },
            "mtb_routes": {
              "$ref": "#/$defs/Weight"
            },
            "near_road": {
              "$ref": "#/$defs/Weight"
            },
            "novel": {
              "$ref": "#/$defs/Weight"
            },
            "open": {
              "$ref": "#/$defs/Weight"
            },
            "path": {
              "$ref": "#/$defs/Weight"
            },
            "paved_rough": {
              "$ref": "#/$defs/Weight"
            },
            "paved_smooth": {
              "$ref": "#/$defs/Weight"
            },
            "quiet": {
              "$ref": "#/$defs/Weight"
            },
            "ramps_over_10": {
              "$ref": "#/$defs/Weight"
            },
            "ramps_over_12": {
              "$ref": "#/$defs/Weight"
            },
            "ramps_over_15": {
              "$ref": "#/$defs/Weight"
            },
            "ramps_over_6": {
              "$ref": "#/$defs/Weight"
            },
            "ramps_over_8": {
              "$ref": "#/$defs/Weight"
            },
            "residential": {
              "$ref": "#/$defs/Weight"
            },
            "service": {
              "$ref": "#/$defs/Weight"
            },
            "sketchy": {
              "$ref": "#/$defs/Weight"
            },
            "smoothness": {
              "$ref": "#/$defs/Weight"
            },
            "soft_ground": {
              "$ref": "#/$defs/Weight"
            },
            "speed": {
              "$ref": "#/$defs/Weight"
            },
            "stale": {
              "$ref": "#/$defs/Weight"
            },
            "steep": {
              "$ref": "#/$defs/Weight"
            },
            "track": {
              "$ref": "#/$defs/Weight"
            },
            "tracktype": {
              "$ref": "#/$defs/Weight"
            },
            "unknown_surface": {
              "$ref": "#/$defs/Weight"
            },
            "unpaved": {
              "$ref": "#/$defs/Weight"
            },
            "visibility": {
              "$ref": "#/$defs/Weight"
            },
            "water": {
              "$ref": "#/$defs/Weight"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "limits": {
          "description": "Hard limits.",
          "type": "object",
          "properties": {
            "legal_only": {
              "$ref": "#/$defs/LimitValue"
            },
            "max_grade": {
              "$ref": "#/$defs/LimitValue"
            },
            "max_mtb_scale": {
              "$ref": "#/$defs/LimitValue"
            },
            "no_ferries": {
              "$ref": "#/$defs/LimitValue"
            },
            "no_main_roads": {
              "$ref": "#/$defs/LimitValue"
            },
            "no_stairs": {
              "$ref": "#/$defs/LimitValue"
            },
            "no_unknown_surface": {
              "$ref": "#/$defs/LimitValue"
            },
            "paved_only": {
              "$ref": "#/$defs/LimitValue"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "bounds": {
          "description": "The factor clamp; defaults apply when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/Bounds"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_m": {
          "description": "What a right-angle turn at a junction costs, metres-equivalent (0..=500; absent:\n[`TURN_M`]; 0: turns are free). Straight on costs nothing, a U-turn twice this; leaving the\nthrough road at least half of it (`docs/routing.md#turns`).",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      },
      "additionalProperties": false
    },
    "Weight": {
      "description": "A soft preference's strength: -100 avoid, 0 neutral, +100 seek.",
      "type": "integer",
      "minimum": -100,
      "maximum": 100
    },
    "LimitValue": {
      "description": "A limit's setting: a switch (`true` on, `false` off, as if absent), or a number for limits that\ntake one (`true` there means the catalogue's default number).",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number",
          "format": "double"
        }
      ]
    },
    "Bounds": {
      "description": "The clamp of the factor product (`docs/profile.md`): every arc costs between `min_factor` and\n`max_factor` times its length (plus additive terms). `min_factor` is the A* bound.",
      "type": "object",
      "properties": {
        "min_factor": {
          "description": "0.3..=1.0, default 0.5. Lower lets bonuses stack further (and searches slow down a little).",
          "type": "number",
          "format": "float",
          "default": 0.5
        },
        "max_factor": {
          "description": "2..=100, default 20. The most an allowed way can cost per metre.",
          "type": "number",
          "format": "float",
          "default": 20.0
        }
      },
      "additionalProperties": false
    },
    "EdgeOverride": {
      "description": "One edge's exception in a plan.",
      "type": "object",
      "properties": {
        "edge": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/OverrideKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "edge",
        "kind"
      ]
    },
    "OverrideKind": {
      "description": "What an override does to its edge.",
      "oneOf": [
        {
          "description": "Not ridden unless there is no other way ([`AVOID_M`] per full arc on top).",
          "type": "string",
          "const": "avoid"
        },
        {
          "description": "Counts at the profile's `min_factor` (plus its additive terms); the limits do not close it.",
          "type": "string",
          "const": "prefer"
        },
        {
          "description": "The limits do not close it (a bicycle ban and one-way still do); costed as if they were off.",
          "type": "string",
          "const": "allow"
        }
      ]
    }
  }
}
